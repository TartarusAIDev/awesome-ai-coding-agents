{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/TartarusAIDev/awesome-ai-coding-agents/data/schema.json",
  "title": "AI coding agents dataset",
  "type": "object",
  "required": ["updated", "count", "agents"],
  "properties": {
    "$schema": { "type": "string" },
    "updated": { "type": "string", "format": "date" },
    "count": { "type": "integer", "minimum": 0 },
    "notes": { "type": "string" },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/agent" }
    }
  },
  "definitions": {
    "flag": {
      "description": "Editorial feature flag.",
      "enum": [true, false, "partial", "unknown"]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "homepage", "github", "description", "category",
        "interface", "open_source", "license", "stars", "last_commit",
        "local_models", "provider_flexibility", "tool_execution",
        "platforms", "pricing", "source", "verified"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "homepage": { "type": "string", "pattern": "^https?://" },
        "github": {
          "type": ["string", "null"],
          "pattern": "^https://github.com/"
        },
        "description": { "type": "string", "minLength": 10 },
        "category": {
          "enum": ["cli-agent", "ide-agent", "autonomous", "developer-tool"]
        },
        "interface": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["cli", "ide", "browser", "api"] }
        },
        "open_source": { "type": "boolean" },
        "license": { "type": "string", "minLength": 1 },
        "stars": { "type": ["integer", "null"], "minimum": 0 },
        "last_commit": { "type": ["string", "null"] },
        "local_models": { "$ref": "#/definitions/flag" },
        "provider_flexibility": { "$ref": "#/definitions/flag" },
        "tool_execution": { "$ref": "#/definitions/flag" },
        "platforms": {
          "type": "array",
          "items": { "enum": ["macos", "linux", "windows", "web"] }
        },
        "pricing": { "enum": ["free", "freemium", "paid", "unknown"] },
        "source": { "enum": ["github-api", "homepage"] },
        "verified": { "type": "string", "format": "date" }
      }
    }
  }
}
